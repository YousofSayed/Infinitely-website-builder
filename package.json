{
  "name": "infinitely-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Infinitely Studio - Visual Website Builder",
  "author": "Infinitely Studio",
  "type": "module",
  "icon": "/puplic/logo.svg",
  "scripts": {
    "start": "vite",
    "dev": "node --max-old-space-size=8024 ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=8024 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run start\" \"wait-on https://localhost:5173 && electronmon --trace  .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:app": "electron-builder",
    "electron": "electronmon --trace --js-flags=--expose-gc .",
    "lint": "eslint . src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.ts,.jsx,.tsx --fix"
  },
  "main": "electron-main.cjs",
  "electronmon": {
    "patterns": [
      "!src/**",
      "!public/**",
      "!dist/**",
      "!node_modules/**"
    ]
  },
  "build": {
    "appId": "com.infinitely.app",
    "productName": "Infinitely Studio",
    "publish": {
      "provider": "github",
      "owner": "YousofSayed",
      "repo": "Infinitely-website-builder",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "desktop/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        }
      ]
    },
    "mac": {
      "icon": "public/favicon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        }
      ]
    },
    "linux": {
      "icon": "public/logo.svg",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Infinitely Studio <infinitely.studio.dev@gmail.com>",
      "publish": [
        {
          "provider": "github",
          "releaseType": "release"
        }
      ]
    }
  },
  "dependencies": {
    "@anandarizki/use-undo-redo": "^1.0.9",
    "@babel/plugin-transform-modules-umd": "^7.27.1",
    "@babel/standalone": "^7.28.0",
    "@floating-ui/react": "^0.27.20",
    "@formkit/auto-animate": "^0.8.2",
    "@grapesjs/react": "^2.0.0",
    "@million/lint": "^1.0.14",
    "@monaco-editor/loader": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@tanstack/react-query": "^5.101.4",
    "@themaximalist/llm.js": "^1.0.3",
    "@typescript/ata": "^0.9.8",
    "@wordpress/block-serialization-default-parser": "^5.21.0",
    "@zumer/snapdom": "^1.9.14",
    "console-feed": "^3.8.0",
    "css": "^3.0.0",
    "css-tree": "^3.1.0",
    "csso": "^5.0.5",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.4.15",
    "downshift": "^9.4.0",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.5.0",
    "grapesjs": "^0.22.13",
    "highlight.js": "^11.12.0",
    "html2canvas-pro": "^1.5.8",
    "interactjs": "^1.10.27",
    "js-beautify": "^1.15.4",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.9",
    "lodash": "^4.17.21",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "million": "^3.1.11",
    "mime": "^4.0.7",
    "object-literal-parse": "^2.1.0",
    "opfs-tools": "^0.7.2",
    "peerjs": "^1.5.4",
    "petite-vue": "^0.4.1",
    "react": "^18.3.1",
    "react-animate-height": "^3.2.4",
    "react-colorful": "^5.6.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-error-boundary": "^5.0.0",
    "react-horizontal-scrolling-menu": "^8.3.2",
    "react-mentions": "^4.4.10",
    "react-resizable-panels": "^4.14.1",
    "react-responsive-overflow-list": "^0.5.0",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.5.0",
    "react-sortablejs": "^6.1.4",
    "react-toastify": "^11.0.5",
    "react-tooltip": "^5.28.0",
    "react-virtuoso": "^4.18.11",
    "recoil": "^0.7.7",
    "serialize-javascript": "^6.0.2",
    "sortablejs": "^1.15.7",
    "terser": "^5.39.0",
    "textarea-caret": "^3.1.0",
    "use-debounce": "^10.0.5",
    "virtua": "^0.51.2",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "@types/css": "^0.0.38",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@welldone-software/why-did-you-render": "^8.0.3",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electronmon": "^2.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "grapesjs-cli": "^4.1.3",
    "gsap": "^3.12.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-mkcert": "^1.17.9",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-webpackchunkname": "^1.0.3",
    "wait-on": "^8.0.3"
  }
}
